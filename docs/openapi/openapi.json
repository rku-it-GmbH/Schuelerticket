					"504": {
						"description": "Gateway Timeout",
						"content": {
							"text/plain": {}
						}
					}
				}
			}
		}
	},
	"components": {
		"schemas": {
			"BasicData": {
				"type": "object",
				"description": "Basisdaten zum Antrag - In diesem Element werden alle Basisdaten des Antrages übergeben, z.B. der gewünschte Gültigkeitsbeginn des Tickets",
				"properties": {
					"requestDate": {
						"type": "string",
						"format": "date-time",
						"description": "Datum an dem der Antrag durch den Antragsteller gestellt wurde",
						"example": "2022-07-21"
					},
					"processingDate": {
						"type": "string",
						"format": "date-time",
						"description": "Datum, an dem der Antrag durch den Schulträger bearbeitet bzw. entschieden wurde",
						"example": "2022-07-21"
					},
					"sender": {
						"type": "string",
						"description": "Sender des Antrags. Das ist in der Regel der Schulträger. Empfohlen wird die Nutzung der Schulträgerdaten, die das Schulministerium NRW als Open-Date bereitstellt",
						"example": "Schulamt Gelsenkirchen"
					},
					"requestID": {
						"type": "string",
						"description": "Antragsnummer aus dem Schulträgersystem",
						"example": "123456A9"
					},
					"reductionEntitled": {
						"type": "boolean",
						"description": "Besteht ein Anspruch auf Ermäßigung",
						"example": true
					},
					"personalContribution": {
						"type": "string",
						"description": "Eigenanteil",
						"enum": [
							"Full",
							"High",
							"Low",
							"None"
						],
						"example": "High"
					},
					"note": {
						"type": "string",
						"description": "Notiz des Schulträgers an das Verkehrsunter-nehmen. Nur mit Merkmalen, die das Vertrags-verhältnis betreffen auszufüllen. \r\n Anmerkungen zum Antrag können hier als Frei-text festgehalten werden",
						"example": "Bitte erneut prüfen"
					},
					"requestType": {
						"type": "string",
						"description": "Antragsart",
						"enum": [
							"Initial",
							"Followup",
							"Change_Payment",
							"Change_Address",
							"Change_School",
							"Cancel",
							"Other"
						],
						"example": "Initial"
					}
				},
				"required": [
					"personalContribution",
					"reductionEntitled",
					"requestDate",
					"requestID",
					"requestType"
				]
			},
			"Consent": {
				"type": "object",
				"description": "Zustimmungen einer Person.",
				"properties": {
					"privacyPolicy": {
						"type": "boolean",
						"description": "Kenntnisnahme der Datenschutzerklärung",
						"example": true
					},
					"marketing": {
						"type": "boolean",
						"description": "Zustimmung zu Marketingmaßnahmen (Information und Eigenwerbung z.B. für neue Angebote für Schüler)",
						"example": true
					},
					"marketResearch": {
						"type": "boolean",
						"description": "Zustimmung zu Markt- und Meinungsforschung (z.B. Teilnahme an Umfragen)",
						"example": true
					},
					"contactViaPhone": {
						"type": "boolean",
						"description": "Zustimmung zur Kontaktierung per Telefon",
						"example": true
					},
					"contactViaMail": {
						"type": "boolean",
						"description": "Zustimmung zur Kontaktierung per Post",
						"example": true
					},
					"contactViaEMail": {
						"type": "boolean",
						"description": "Zustimmung zur Kontaktierung per E-Mail",
						"example": true
					}
				},
				"required": [
					"contactViaEMail",
					"contactViaMail",
					"contactViaPhone",
					"marketResearch",
					"marketing",
					"privacyPolicy"
				]
			},
			"Contact": {
				"type": "object",
				"description": "Kontaktdaten einer Person.",
				"properties": {
					"studentID": {
						"type": "string",
						"description": "Falls die Kontaktperson ein Schüler ist: ID des Schülers im Schulträgersystem (z.B. SchILD-NRW, winSchool, o.a.). Die ID ist dem Schüler i.A. nicht bekannt. Bei Schulwechsel oder Umzug kann sich diese ID ändern.",
						"example": "12345A99"
					},
					"lastname": {
						"type": "string",
						"description": "Nachname",
						"example": "Müller",
						"maxLength": 120,
						"minLength": 0
					},
					"firstname": {
						"type": "string",
						"description": "Vorname",
						"example": "Marie",
						"maxLength": 80,
						"minLength": 0
					},
					"customerNumber": {
						"type": "string",
						"description": "Kundennummer des Schülers beim Verkehrsun-ternehmen falls bekannt (bei Folge-/Änderungsanträgen)",
						"example": "1233738B2",
						"maxLength": 64,
						"minLength": 0
					},
					"contractNumber": {
						"type": "string",
						"description": "Vertragsnummer des Schülers beim falls be-kannt (bei Folge-/Änderungsanträgen)",
						"example": "1233738B2"
					},
					"subscriptionNumber": {
						"type": "string",
						"description": "Abonummer des Schülers beim Verkehrsunter-nehmen falls bekannt (bei Folge-/Änderungsanträgen)",
						"example": "1233738B2"
					},
					"birthdate": {
						"type": "string",
						"format": "date",
						"description": "Geburtsdatum. Das Geburtsdatum des Schülers wird für die Fahrtberechtigung benötigt, sofern der Tarif dies vorsieht.",
						"example": "2017-07-21"
					},
					"sex": {
						"type": "string",
						"description": "Geschlecht. Das Geschlecht des Schülers wird für die Fahrt-berechtigung benötigt, sofern der Tarif dies vorsieht",
						"enum": [
							"unknown",
							"male",
							"female",
							"diverse",
							"not_specified"
						],
						"example": "male"
					},
					"street": {
						"type": "string",
						"description": "Straße",
						"example": "Cloudstraße",
						"maxLength": 55,
						"minLength": 0
					},
					"streetnumber": {
						"type": "string",
						"description": "Hausnummer",
						"example": 22,
						"maxLength": 9,
						"minLength": 0
					},
					"streetnumberExtension": {
						"type": "string",
						"description": "Hausnummernzusatz",
						"example": "A",
						"maxLength": 10,
						"minLength": 0
					},
					"adressExtension": {
						"type": "string",
						"description": "Adresszusatz. Zusatzangabe zur Hausnummer",
						"example": "Hinterhaus",
						"maxLength": 10,
						"minLength": 0
					},
					"pobox": {
						"type": "string",
						"description": "Postfach",
						"example": 12,
						"maxLength": 10,
						"minLength": 0
					},
					"postalcode": {
						"type": "string",
						"description": "PLZ - Postleitzahl",
						"example": 44141,
						"maxLength": 5,
						"minLength": 5
					},
					"city": {
						"type": "string",
						"description": "Ort - Wohnort",
						"example": "Dortmund",
						"maxLength": 105,
						"minLength": 0
					},
					"district": {
						"type": "string",
						"description": "Ortsteil bei ausländischem Wohnort",
						"example": "Lütgendortmund"
					},
					"country": {
						"type": "string",
						"description": "Land bei ausländischem Wohnort",
						"example": "Deutschland"
					},
					"phonenumber": {
						"type": "string",
						"description": "Telefonnummer",
						"example": "0123456789",
						"maxLength": 20,
						"minLength": 0
					},
					"emailAddress": {
						"type": "string"
					}
				},
				"required": [
					"firstname",
					"lastname"
				]
			},
			"PaymentDetails": {
				"type": "object",
				"properties": {
					"bankName": {
						"type": "string",
						"description": "Name der Bank, nur optionale Angabe zur Kontrolle",
						"example": "Sparkasse Herne",
						"maxLength": 64,
						"minLength": 0
					},
					"iban": {
						"type": "string",
						"description": "IBAN",
						"example": "DEABCDEF123456789",
						"maxLength": 34,
						"minLength": 15
					},
					"bic": {
						"type": "string",
						"description": "BIC",
						"example": "WELADED2HER",
						"maxLength": 20,
						"minLength": 0
					},
					"payer": {
						"$ref": "#/components/schemas/Contact",
						"description": "Kontoinhaber"
					},
					"directDebitConsent": {
						"type": "boolean",
						"description": "Zustimmung SEPA Lastschrift",
						"example": true
					},
					"creditCheckConsent": {
						"type": "boolean",
						"description": "Zustimmung Bonitätsprüfung",
						"example": true
					},
					"payment": {
						"type": "string",
						"description": "Art der Zahlung",
						"enum": [
							"Invoice",
							"DirectDebit"
						],
						"example": "Invoice"
					}
				},
				"required": [
					"creditCheckConsent",
					"directDebitConsent",
					"payment"
				]
			},
			"Request": {
				"type": "object",
				"properties": {
					"basicData": {
						"$ref": "#/components/schemas/BasicData",
						"description": "Basisdaten des Antrags"
					},
					"ticketInformation": {
						"$ref": "#/components/schemas/TicketInformation",
						"description": "Informationen die für die Ausstellung des Tickets benötigt werden"
					},
					"student": {
						"$ref": "#/components/schemas/Contact",
						"description": "Kontaktdaten des Schülers"
					},
					"representative": {
						"$ref": "#/components/schemas/Contact",
						"description": "Kontaktdaten des gesetzlichen Vertreters des Schülers ([Erziehungsberechtig-ter/Sorgeberechtigter/Vormund]) \r\nBei minderjährigen Schülern ist die Angabe eines gesetzlichen Vertreters verpflichtend. \r\nBei geteiltem Sorgerecht benötigt das Verkehrs-unternehmen einen eindeutigen Ansprechpart-ner. Es kann darum nur ein gesetzlicher Vertreter angegeben werden."
					},
					"paymentDetails": {
						"$ref": "#/components/schemas/PaymentDetails",
						"description": "Informationen zur Zahlung des Tickets"
					},
					"consent": {
						"$ref": "#/components/schemas/Consent",
						"description": "Diverse Einwilligungen des Schülers/gesetzlichen Vertreters"
					},
					"schoolInformation": {
						"$ref": "#/components/schemas/SchoolInformation",
						"description": "Informationen zur Schule, die der Schüler besucht"
					},
					"siblings": {
						"type": "array",
						"description": "Geschwister des Schülers\r\nDiese Daten sind für die Prüfung auf anspruchs-berechtigte Geschwister nötig. \r\nGrundsätzlich sind die Schulträger für die Prüfung verantwortlich. Diese wird aber meist nur bei kommunalen Trägern und nur für die eigenen Schulen durchgeführt (und nicht für andere Schulträger oder Kommunen). \r\nDie Angabe ist nur erforderlich, falls das Ver-kehrsunternehmen selbst eine Prüfung der Ge-chwister durchführt. \r\n",
						"items": {
							"$ref": "#/components/schemas/Sibling"
						}
					}
				},
				"required": [
					"basicData",
					"consent",
					"student",
					"ticketInformation"
				]
			},
			"School": {
				"type": "object",
				"properties": {
					"schoolId": {
						"type": "integer",
						"format": "int64",
