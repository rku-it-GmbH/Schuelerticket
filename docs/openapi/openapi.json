						"type": "string",
						"description": "Ermittelte Produktnummer",
						"example": "619A1"
					},
					"price": {
						"type": "number",
						"format": "float",
						"description": "Ermittelter Preis",
						"example": 15.9
					},
					"customerNumber": {
						"type": "string",
						"description": "Kundennummer der Person beim Verkehrsun-ternehmen (bei Folge-/Änderungsanträgen)",
						"example": "1233738B2"
					},
					"contractNumber": {
						"type": "string",
						"description": "Vertragsnummer der Person beim Verkehrsun-ternehmen (bei Folge-/Änderungsanträgen)",
						"example": "1233738B2"
					},
					"subscriptionNumber": {
						"type": "string",
						"description": "Abonummer der Person beim Verkehrsunter-nehmen (bei Folge-/Änderungsanträgen)",
						"example": "1233738B2"
					},
					"status": {
						"$ref": "#/components/schemas/RequestStatus",
						"description": "Status des Antrags: \n* `UNPROCESSED` - Unprocessed (noch nicht verarbeitet)\n* `ERROR` - error (Fehler bei der Verarbeitung)\n* `APPROVED` - approved (Antrag angenommen)\n* `DENIED` - denied (Antrag abgelehnt)\n* `NEEDS_REVISION` - needs_revision (muss überarbeitet wer-den)\n* `OTHER` - other (anderes)",
						"example": "approved"
					},
					"note": {
						"type": "string",
						"description": "Notiz des Bearbeiters. Beispielsweise Begründung zum Status",
						"example": "Adresse des Kindes ist nicht bekannt"
					},
					"errors": {
						"type": "object",
						"additionalProperties": {
							"type": "string"
						},
						"description": "Fehler bei der Verarbeitung. Fehlercode und Text sind zwischen den beiden Schnittstellennutzern zu vereinbaren"
					}
				},
				"required": [
					"requestID"
				]
			},
			"RequestStatus": {
				"type": "string",
				"enum": [
					"unprocessed",
					"error",
					"approved",
					"denied",
					"needs_revision",
					"other"
				]
			}
		}
	}
