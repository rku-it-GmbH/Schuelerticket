{
	"openapi": "3.1.0",
	"info": {
		"title": "Schülerticket API",
		"description": "Schülerticket Schnittstelle zwischen Schulträger und VU in NRW",
		"contact": {
			"name": "Lukas Sauerbier",
			"url": "https://github.com/rku-it-GmbH/Schuelerticket",
			"email": "lukas.sauerbier@rku-it.de",
			"x-Company": "rku.it GmbH",
			"x-Company-URL": "https://rku-it.de"
		},
		"license": {
			"name": "MIT License",
			"url": "https://github.com/rku-it-GmbH/Schuelerticket/blob/main/LICENSE"
		},
		"version": "v0.8.1"
	},
	"servers": [
		{
			"url": "http://localhost:8080/studentticketapi",
			"description": "localhost"
		}
	],
	"paths": {
		"/api/sendRequest": {
			"post": {
				"tags": [
					"School Data API"
				],
				"summary": "Übertragen eines Datensatzes an das Verkehrsunternehmen",
				"operationId": "api",
				"parameters": [
					{
						"name": "X-API-KEY",
						"in": "header",
						"required": false,
						"schema": {
							"type": "string"
						}
					}
				],
				"requestBody": {
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/Request"
							}
						},
						"application/xml": {
							"schema": {
								"$ref": "#/components/schemas/Request"
							}
						}
					},
					"required": true
				},
				"responses": {
					"200": {
						"description": "OK!"
					},
					"400": {
						"description": "Fehler bei der Validierung der Anfrage",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							},
							"application/xml": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"401": {
						"description": "API Key leer oder nicht angegeben",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							},
							"application/xml": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"403": {
						"description": "API Key nicht gefunden",
						"content": {
							"text/plain": {}
						}
					},
					"405": {
						"description": "Anfrage muss ein POST-Request sein",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							},
							"application/xml": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"406": {
						"description": "Accept-Header kann nicht erfüllt werden",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							},
							"application/xml": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"415": {
						"description": "Content-Type wird nicht unterstützt",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							},
							"application/xml": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"500": {
						"description": "Interner Serverfehler",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							},
							"application/xml": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"502": {
						"description": "Bad Gateway",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							},
							"application/xml": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"503": {
						"description": "Service Unavailable",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							},
							"application/xml": {
								"schema": {
									"type": "string"
								}
							}
						}
					},
					"504": {
						"description": "Gateway Timeout",
						"content": {
							"application/json": {
								"schema": {
									"type": "string"
								}
							},
							"application/xml": {
								"schema": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		},
		"/api/stoplist": {
